# Copia a .env y completa. Sin API key el proyecto funciona en modo demo (texto simulado, imagen placeholder).
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
NANOGPT_TEXT_MODEL=chatgpt-4o-latest
NANOGPT_IMAGE_MODEL=hidream
# Tamaño de imagen: usa RESOLUTION (1k, 1.5k) para modelos como anima, o SIZE (1024x1024) para el resto.
NANOGPT_IMAGE_RESOLUTION=
NANOGPT_IMAGE_SIZE=1024x1024
# Nombre con el que el lorebook resuelve {{user}} (el master). Por defecto: el master.
MASTER_NAME=el master
PORT=3000
